# === Alisa AI backend ===
DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=0
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
DEFAULT_LOG_CHANNEL_ID=0

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Voice interaction
WAKE_WORD=helper
WAKE_ALIASES=хелпер
STOP_WORDS=стоп,stop,стоп хелпер
STT_LANGUAGE=ru-RU
LISTEN_TIMEOUT_SECONDS=7.0
MAX_HISTORY_TURNS=12

# TTS (edge-tts): ru-RU-SvetlanaNeural (мягкий) / ru-RU-DariyaNeural (живой)
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+4%
TTS_VOLUME=+0%

# WebSocket bridge for the Discord Activity frontend
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
